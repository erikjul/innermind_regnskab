# Én blok pr. app. Adresserne sættes i .env (GOLF_DOMAENE, REGNSKAB_DOMAENE).
# Caddy henter og fornyer HTTPS-certifikater automatisk. Uden eget domæne bruges serverens IP via
# sslip.io med et præfiks pr. app, fx golf.65-108-1-2.sslip.io og regnskab.65-108-1-2.sslip.io.
# Servicenavnene (golf, regnskab) er de netværksaliaser, appernes docker-compose.yml giver dem.

(sikkerhed) {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}

{$GOLF_DOMAENE} {
    import sikkerhed
    reverse_proxy golf:8010
}

{$REGNSKAB_DOMAENE} {
    import sikkerhed
    header X-Frame-Options SAMEORIGIN
    request_body {
        max_size 40MB
    }
    reverse_proxy regnskab:8000
}
