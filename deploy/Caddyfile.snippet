# Tilføj denne blok nederst i serverens eksisterende Caddyfile (fx /opt/server-proxy/Caddyfile) og genindlæs Caddy:
#   cd /opt/server-proxy && docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
# Containernavnet "innermind-regnskab" kommer fra deploy/docker-compose.bag-proxy.yml, og begge containere
# skal være på samme Docker-netværk (PROXY_NETWORK).

regnskab.innermind.dk {
    encode gzip
    request_body {
        max_size 40MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
    }
    reverse_proxy innermind-regnskab:8000
}
