# Nøgle til Claude API (bruges til aflæsning af fakturaer)
ANTHROPIC_API_KEY=sk-ant-...

# --- Kun på server (docker compose) ---
# Domæne til HTTPS. Eget domæne (regnskab.innermind.dk, med A-record til serverens IP)
# eller serverens IP via sslip.io, fx 65-108-1-2.sslip.io
REGNSKAB_DOMAENE=regnskab.eksempel.dk
# Tilfældig hemmelighed til login-cookien. Lav én med:  openssl rand -base64 48
REGNSKAB_SESSION_SECRET=skift-mig
# Kun hvis serveren allerede har en proxy (Caddy/nginx) i Docker: navnet på dens Docker-netværk.
# Find det med:  docker inspect <proxy-container> -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
# PROXY_NETWORK=server-proxy_default

# --- Valgfrit ---
# Hvor data (database, bilag) gemmes ved lokal kørsel. Standard: ./data
# REGNSKAB_DATA_DIR=/sti/til/data
# Mappe til sikkerhedskopier – peg den på en cloud-synkroniseret mappe ved lokal kørsel
# REGNSKAB_BACKUP_DIR=/Users/dig/OneDrive/InnerMind-regnskab-backup
# Model til fakturaaflæsning
# REGNSKAB_CLAUDE_MODEL=claude-opus-5

# --- Avatar (Avatar-siden: tal med en tegnet golfspiller på engelsk) ---
# Stemme fra ElevenLabs. Uden nøgle bruges telefonens egen oplæsning. Stemme-id er valgfrit (standard: "Lily", britisk).
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
# Model til avatarens svar (standard: samme som REGNSKAB_CLAUDE_MODEL)
# REGNSKAB_AVATAR_MODEL=claude-opus-5
