# Nøgle til Claude API (bruges til aflæsning af fakturaer)
ANTHROPIC_API_KEY=sk-ant-...

# --- Kun på server (docker compose) ---
# Adressen (REGNSKAB_DOMAENE) sættes i server-proxy/.env, hvor den fælles Caddy bor.
# Tilfældig hemmelighed til login-cookien. Lav én med:  openssl rand -base64 48
REGNSKAB_SESSION_SECRET=skift-mig

# --- Valgfrit ---
# Hvor data (database, bilag) gemmes ved lokal kørsel. Standard: ./data
# REGNSKAB_DATA_DIR=/sti/til/data
# Mappe til sikkerhedskopier – peg den på en cloud-synkroniseret mappe ved lokal kørsel
# REGNSKAB_BACKUP_DIR=/Users/dig/OneDrive/InnerMind-regnskab-backup
# Model til fakturaaflæsning
# REGNSKAB_CLAUDE_MODEL=claude-opus-5
