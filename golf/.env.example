# Domæne til HTTPS (kun ved docker compose). Eget domæne med A-record til serverens IP,
# eller serverens IP via sslip.io, fx 65-108-1-2.sslip.io
GOLF_DOMAENE=golf.eksempel.dk

# Valgfri PIN. Er den sat, kræves den for at gemme baneopsætning, lukke runder og slette spillere.
# Alle kan stadig tilmelde sig og taste scorer uden PIN. Tom = ingen PIN.
GOLF_PIN=

# Hvor golf.json gemmes ved lokal kørsel. Standard: golf/data
# GOLF_DATA_DIR=/sti/til/data
