# Caddy henter og fornyer HTTPS-certifikatet automatisk for domænet i GOLF_DOMAENE.
# Uden eget domæne: brug serverens IP med sslip.io, fx GOLF_DOMAENE=65-108-1-2.sslip.io
{$GOLF_DOMAENE} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    reverse_proxy golf:8010
}
